{
	"layer": "top",
	"position": "top",
	"modules-left": [
		"hyprland/workspaces"
	],
	"modules-center": [
		"clock"
	],
	"modules-right": [
		"network",
		"pulseaudio"
	],
	"clock": {
		"format": "{:%a %d %b %H:%M}"
	},
	"network": {
		"format-wifi": "{essid}",
		"format-ethernet": "Ethernet",
		"format-disconnected": "Offline"
	},
	"pulseaudio": {
		"format": "{volume}%",
		"format-muted": "Muted {volume}%",
		"on-click": "pavucontrol"
	},
	"hyprland/workspaces": {
		"format": "{name}",
		"all-outputs": false,
		"persistent-workspaces": {
			"DP-9": [1, 2, 3, 4],
			"DP-5": [5, 6, 7, 8]
		}
	}
}
