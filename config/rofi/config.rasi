configuration {
    modi: "drun";
    show-icons: true;
    drun-display-format: "{name}";
    font: "sans 14";
}

* {
    background: #111111;
    background-alt: #1b1b1b;
    foreground: #eeeeee;
    selected: #2a2a2a;
    border: #444444;
}

window {
    width: 40%;
    background-color: @background;
    border: 1px;
    border-color: @border;
    border-radius: 8px;
}

mainbox {
    padding: 12px;
    background-color: @background;
}

inputbar {
    padding: 10px;
    margin: 0 0 10px 0;
    background-color: @background-alt;
    border-radius: 6px;
}

prompt {
    text-color: @foreground;
}

entry {
    text-color: @foreground;
}

listview {
    lines: 8;
    spacing: 4px;
    background-color: @background;
}

element {
    padding: 8px;
    border-radius: 5px;
    text-color: @foreground;
}

element selected {
    background-color: @selected;
    text-color: @foreground;
}

element-icon {
    size: 24px;
    margin: 0 10px 0 0;
}

element normal.normal,
element alternate.normal {
    background-color: @background;
    text-color: @foreground;
}

element selected.normal {
    background-color: @selected;
    text-color: @foreground;
}
